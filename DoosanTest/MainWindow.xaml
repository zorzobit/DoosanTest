<Window x:Class="DoosanTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoosanTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="VerticalSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="25" Height="40">
                            <!-- Background -->
                            <Border x:Name="SwitchBackground" Width="25" Height="40"
                                    CornerRadius="12" Background="#E5E5E5"/>

                            <!-- Knob -->
                            <Border x:Name="SwitchKnob" Width="20" Height="20"
                                    CornerRadius="10" Background="White"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Border.Effect>
                                    <DropShadowEffect Color="#888" BlurRadius="3" ShadowDepth="1.5"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBackground" Property="Background" Value="#4CD964"/>
                                <Setter TargetName="SwitchKnob" Property="VerticalAlignment" Value="Bottom"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding Connect}" Content="{Binding ConnectionButtonText}" Margin="5"/>
                <TextBox Text="{Binding IpString}" Margin="5" IsEnabled="{Binding IpBoxIsEnabled}"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="{Binding IsConnectedText}"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="System Version: " Background="AliceBlue"></Label>
                        <Label Content="{Binding SystemVerLabel}"  Background="LawnGreen" Width="70"></Label>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Library Version: " Background="AliceBlue"></Label>
                        <Label Content="{Binding LibraryVerLabel}"  Background="LawnGreen" Width="70"></Label>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Robot State: " Background="AliceBlue"></Label>
                        <Label Content="{Binding RobotState}"  Background="LawnGreen" Width="70"></Label>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Speed Mode: " Background="AliceBlue"></Label>
                        <Label Content="{Binding SpeedMode}"  Background="LawnGreen" Width="70"></Label>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Program State: " Background="AliceBlue"></Label>
                        <Label Content="{Binding ProgramState}"  Background="LawnGreen" Width="70"></Label>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding NumberList}" SelectedItem="{Binding SelectedIONum}" Width="100" Height="30"/>
                        <Button Margin="5" Width="60" Content="{Binding IOisON}" Command="{Binding SetIO}" IsEnabled="{Binding IsNotBusy}"></Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="Black" BorderThickness="2" CornerRadius="5" Margin="5">
                            <UniformGrid Rows="2" Columns="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output0}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output1}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output2}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output3}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output4}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output5}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output6}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output7}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output8}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output9}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output10}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output11}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output12}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output13}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output14}"/>
                                <ToggleButton Style="{StaticResource VerticalSwitchStyle}" Margin="4" IsChecked="{Binding Output15}"/>
                            </UniformGrid>
                        </Border>
                        <!--<Button Margin="5" Content="{Binding RobotMode}" Command="{Binding SwitchMode}" IsEnabled="{Binding IsNotBusy}"></Button>
                        <Button Margin="5" Content="MoveJ" Command="{Binding MoveJ}" IsEnabled="{Binding IsNotBusy}"></Button>
                        <Button Margin="5" Content="Reset" Command="{Binding Reset}" IsEnabled="{Binding IsNotBusy}"></Button>-->
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 30: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg30}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 31: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg31}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="  Val x: " Background="AliceBlue"></Label>
                            <TextBox Text="{Binding posxval}" Margin="5"   Background="Cyan" Width="70"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 32: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg32}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 33: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg33}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="  Val y: " Background="AliceBlue"></Label>
                            <TextBox Text="{Binding posyval}" Margin="5"   Background="Cyan" Width="70"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 34: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg34}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 35: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg35}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="  Val z: " Background="AliceBlue"></Label>
                            <TextBox Text="{Binding poszval}" Margin="5"   Background="Cyan" Width="70"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 36: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg36}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 37: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg37}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Val Rx: " Background="AliceBlue"></Label>
                            <TextBox Text="{Binding posrxval}" Margin="5"   Background="Cyan" Width="70"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 38: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg38}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 39: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg39}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Val Ry: " Background="AliceBlue"></Label>
                            <TextBox Text="{Binding posryval}" Margin="5"   Background="Cyan" Width="70"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 40: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg40}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Reg 41: " Background="AliceBlue"></Label>
                            <Label Content="{Binding Reg41}"  Background="LawnGreen" Width="70"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Val Rx: " Background="AliceBlue"></Label>
                            <TextBox Text="{Binding posrzval}" Margin="5"   Background="Cyan" Width="70"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Width="333">
                        <Button Margin="5" Width="60" Content="SET" Command="{Binding SetReg}" IsEnabled="{Binding IsNotBusy}"></Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Margin="5" MinWidth="50" ItemsSource="{Binding RegisterCount}" SelectedItem="{Binding SelectedRegister}"/>
                        <TextBox Margin="5"  MinWidth="80" Text="{Binding RegisterValue}"/>
                        <Button Margin="5" Command="{Binding SetRegister}" Content="UPDATE" MinWidth="80"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Width="120">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="J1:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding Joint1}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="J2:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding Joint2}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="J3:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding Joint3}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="J4:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding Joint4}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="J5:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding Joint5}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="J6:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding Joint6}" Background="LawnGreen"></Label>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="120">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="X:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding PosX}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Y:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding PosY}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Z:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding PosZ}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Rx:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding PosRx}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Ry:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding PosRy}" Background="LawnGreen"></Label>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Rz:" Background="AliceBlue"></Label>
                        <Label Grid.Column="1" Content="{Binding PosRz}" Background="LawnGreen"></Label>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
